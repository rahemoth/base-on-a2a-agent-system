# API Keys
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Configuration (Optional)
# Set this to use OpenAI-compatible APIs like LM Studio, LocalAI, etc.
# Example for LM Studio: http://localhost:1234/v1
# OPENAI_BASE_URL=http://localhost:1234/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./agents.db

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RAG Memory System
RAG_ENABLED=true
RAG_EMBEDDING_DIMENSION=768

# ChromaDB persistent vector store directory
CHROMA_PERSIST_DIR=./data/chroma

# LLM-based entity/relation extraction (uses each agent's own LLM client)
ENTITY_EXTRACTION_ENABLED=false
ENTITY_EXTRACTION_MODEL=gpt-4o-mini
ENTITY_EXTRACTION_MAX_TOKENS=800
ENTITY_EXTRACTION_TEMPERATURE=0.2
